#!/bin/sh
# ~/.local/bin/rec
# written by claude
set -u

pidfile="${XDG_RUNTIME_DIR:-/tmp}/wf-recorder.pid"
logdir="${XDG_STATE_HOME:-$HOME/.local/state/wf-recorder}"
outdir="$HOME/tmp"

mkdir -p "$logdir"
mkdir -p "$outdir"

audio_device='alsa_output.pci-0000_00_1b.0.analog-stereo.monitor'
# Haswell i965
export LIBVA_DRIVER_NAME=i965

if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill -INT "$(cat "$pidfile")"
    rm -f "$pidfile"
    notify-send "wf-recorder" "Stopped recording" 
    exit 0
fi

file="$outdir/rec-$(date +%Y%m%d-%H%M%S).mp4"

width="$(swaymsg -t get_outputs | grep -o '"width": [0-9]*' | head -1 | grep -o '[0-9]*')"

if [ "${width:-0}" -ge 2000 ]; then
    bitrate="28M"
else
    bitrate="18M"
fi

wf-recorder \
    -c h264_vaapi \
    -d /dev/dri/renderD128 \
    -p profile=high \
    -b "$bitrate" \
    -f "$file" \
    --audio="$audio_device" \
    > "$logdir/wf-recorder.log" 2>&1 &

echo $! > "$pidfile"
notify-send "wf-recorder" "Started recording: $file" 
