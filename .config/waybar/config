{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": [ "custom/res-toggle", "sway/workspaces", "custom/recorder", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "custom/network-mib",
        "cpu",
        "memory",
        "wireplumber",
        "custom/clock",
        "tray",
        "custom/cleaner"
    ],

    "sway/workspaces": {
        "format": "{icon}",
        "on-scroll-up": "swaymsg workspace next",
        "on-scroll-down": "swaymsg workspace prev"
    },

    "sway/mode": {
        "format": "MODE: {}",
        "max-length": 20
    },

    "sway/window": {
    "ellipsis": true
    },

    "cpu": {
        "format": " {usage}% ",
        "interval": 3,
        "max-length": 15,
        "on-click": "${HOME}/.local/bin/show_uptime"
    },

    "memory": {
        "format": " {used:0.1f}/{total:0.1f} GiB",
        "interval": 10,
        "max-length": 15
    },

    "custom/network-mib": {
    "exec": "${XDG_CONFIG_HOME}/waybar/scripts/waybar-net-mib.sh",
    "interval": 1,
    "max-length": 18,
    "return-type": "json",
    "tooltip-format": "Network downlink speed (MiB/s)"
},

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
        "headphone": "",
        "default": ["", "", ""]
        },
        "scroll-step": 5
    },

     "custom/clock": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/clock.sh",
        "return-type": "json",
        "on-click": "${HOME}/.local/bin/show_cal"
    },
    
    "custom/res-toggle": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/res-toggle.sh",
        "signal": 3,
        "return-type": "text",
        "on-click": "${XDG_CONFIG_HOME}/waybar/scripts/res-toggle.sh toggle",
        "tooltip-format": "Click to toggle HDMI-A-2 resolution"
    },

    "custom/recorder": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/rec-status.sh",
        "return-type": "json",
        "signal": 8,
        "interval": 1,
        "on-click": "$HOME/.local/bin/rec",
        "format": "{}"
    },

    "custom/cleaner": {
        "format": "󰎟",
        "interval": "once",
        "on-click": "makoctl dismiss --all",
        "tooltip-format": "Clean all notifications"
    }
}

