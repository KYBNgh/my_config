#!/bin/sh
# ~/.local/bin/chpaper
# Usage: chpaper /path/to/image.png

wallpaper="${HOME}/.local/share/swaypaper"
lockpaper="${HOME}/.local/share/lockpaper"

if [ $# -ne 1 ]; then
    echo "You must type the path of the wallpaper!"
    exit 1
fi

image=$(readlink -f "$1")

# /dev/null for black wallpaper
if [ ! -f "$image" ] && [ "$image" != "/dev/null" ] ; then
    echo "The wallpaper must be a regular file!"
    exit 1
fi

ln -svf "$image" "$wallpaper" && notify-send -u low 'Wallpaper' "Wallpaper set to $image"
# comment out, 'cause i use blur effect
# ln -svf "$image" "$lockpaper" && notify-send -u low 'Lockpaper' "Lockpaper set to $image"
swaymsg reload
