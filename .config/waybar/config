{
    "layer": "top",
    "position": "top",
    "height": 32,
    
    "modules-left": [
        "custom/res-toggle",
        "mpris",
        "sway/workspaces",
        "custom/recorder",
        "sway/mode"
    ],

    "modules-center": [
        "sway/window"
    ],
    
    "modules-right": [
        "custom/network-mib",
        "cpu",
        "memory",
        "temperature",
        "wireplumber",
        "custom/clock",
        "tray",
        "custom/cleaner"
    ],

    "sway/workspaces": {
        "format": "{icon}",
        "on-scroll-up": "swaymsg workspace next",
        "on-scroll-down": "swaymsg workspace prev"
    },

    "sway/mode": {
        "format": "MODE: {}",
        "max-length": 20
    },

    "sway/window": {
    "ellipsis": true,
    "on-click": "swaymsg fullscreen toggle",
    "on-click-middle": "swaymsg kill",
    "on-click-right": "swaymsg floating toggle"
    },

 "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "interval": 1,
    "max-length": 50,
    "dynamic-len": 35,
    "artist-len": 15,
    "title-len": 25,
    "album-len": 12,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-",
    "player-icons": {
        "default": "",
        "firefox": "",
        "mpv": "󰐍",
        "mpd": ""
    },
    "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
    },
    "tooltip-format": "Left: toggle pause | Middle: previous | Right: next"
},

    "cpu": {
        "format": " {usage}% ",
        "interval": 3,
        "max-length": 15,
        "on-click": "${HOME}/.local/bin/show_uptime",
        "tooltip-format": "CPU: {usage}% · Freq: {avgFrequency} GHz"
    },

    "memory": {
        "format": " {used:0.1f}/{total:0.1f} GiB",
        "interval": 10,
        "max-length": 15,
        "on-click": "foot -T 'floating foot' -e btop",
        "tooltip-format": "RAM: {used:0.1f}/{total:0.1f} GiB ({percentage}%)\nClick to open btop"

    },

    "custom/network-mib": {
    "exec": "${XDG_CONFIG_HOME}/waybar/scripts/waybar-net-mib.sh",
    "interval": 1,
    "max-length": 18,
    "return-type": "json",
    "tooltip-format": "enp3s0 · Downlink speed (MiB/s)"
},
    "temperature": {
        "thermal-zone": 2,
        "interval": 5,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "critical-threshold": 80,
        "tooltip-format": "CPU Package: {temperatureC}°C"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
        "headphone": "",
        "default": ["", "", ""]
        },
        "on-click": "helvum",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Left: helvum | Middle: toggle mute"
    },

     "custom/clock": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/clock.sh",
        "return-type": "json",
        "on-click": "${HOME}/.local/bin/show_cal"
    },
    
    "custom/res-toggle": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/res-toggle.sh",
        "signal": 3,
        "return-type": "text",
        "on-click": "${XDG_CONFIG_HOME}/waybar/scripts/res-toggle.sh toggle",
        "tooltip-format": "HDMI-A-2 · Click to toggle"
    },

    "custom/recorder": {
        "exec": "${XDG_CONFIG_HOME}/waybar/scripts/rec-status.sh",
        "return-type": "json",
        "signal": 8,
        "interval": 1,
        "on-click": "$HOME/.local/bin/rec",
        "format": "{}"
    },

    "custom/cleaner": {
        "format": "󰎟",
        "interval": "once",
        "on-click": "makoctl dismiss --all",
        "tooltip-format": "Clean all notifications"
    }
}

