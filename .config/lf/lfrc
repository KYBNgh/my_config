set hidden
set dirfirst
set dircounts
set number
set mouse
set autoquit
set preview

set promptfmt "\033[38;5;15m%u\033[0m\033[1;38;5;4m@\033[0m\033[38;5;15m%h \033[0m\033[1;38;5;4m%w\033[0m "
set timefmt "2006-01-02 15:04"
set numberfmt "\033[90m"

map D delete
map A :push %mkdir<space>
map a :push %touch<space>

set previewer ~/.local/bin/previewer

map b $bat --pager=never $fx | env -u LESS less -R -i -M -S
map S &pkill -P $$ mpv

cmd open ${{ 
    if test -d "$f"; then
        lf -remote "send $id cd \"$f\""
        exit 0
    fi
    case "$f" in
        *.mp3|*.flac|*.wav|*.aac|*.ogg|*.m4a|*.wma|*.wv|*.opus|*.ape|*.alac|\
        *.mp4|*.mkv|*.avi|*.mov|*.wmv|*.flv|*.webm|*.m4v|*.mpg|*.mpeg|*.3gp|*.ogv|*.ts|*.m2ts)
            mpv "$fx" --really-quiet >/dev/null 2>&1 & ;;
        *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.tiff|*.webp|*.svg|*.ico)
            swayimg "$fx" ;;
        *.html|*.htm)
            w3m "$fx" ;;
        *.txt|*.md|*.conf|*.log|*.json|*.yml|*.yaml|*.toml|*.ini|*.cfg|*.sh|*.bash|*.zsh|*.fish|*.py|*.go|*.rs|*.c|*.cpp|*.h|*.java|*.js|*.ts|*.css|*.scss|*.xml|*.*rc|*.*profile)
            vim "$fx" ;;
        *.pdf)
            ${OPENER:-xdg-open} "$fx" ;;
        *.zip|*.tar|*.gz|*.bz2|*.xz|*.7z|*.rar|*.zst)
            ${OPENER:-xdg-open} "$fx" ;;
        *)
            echo "unknown file type"
    esac
}}
