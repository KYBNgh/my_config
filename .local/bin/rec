#!/bin/sh
# ~/.local/bin/rec
set -u

pidfile="${XDG_RUNTIME_DIR:-/tmp}/wf-recorder.pid"
logdir="${XDG_STATE_HOME:-$HOME/.local/state/wf-recorder}"
outdir="$HOME/tmp"
audio_device="$(pactl get-default-sink 2>/dev/null).monitor"
if [ "$audio_device" = ".monitor" ]; then
    notify-send -u critical "wf-recorder" "An audio error occured, exited!"
    exit 1
fi

mkdir -p "$logdir"
mkdir -p "$outdir"

# AMD GPU
export LIBVA_DRIVER_NAME=radeonsi

if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill -INT "$(cat "$pidfile")"
    pkill -RTMIN+8 waybar
    rm -f "$pidfile"
    notify-send "wf-recorder" "Stopped recording" 
    exit 0
fi

name=""

# _wmenu is  ~/.local/bin/_wmenu
if command -v wmenu >/dev/null 2>&1; then
    if ! name=$(_wmenu -p "Save as:" < /dev/null 2>>"$logdir/wf-recorder.log"); then
#        notify-send -u low "wf-recorder" "Cancelled"
        exit 1
    fi
fi

name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -n "$name" ]; then
    name=$(basename -- "$name")
    name=$(printf '%s' "$name" | tr '/' '_' | tr -d '\r\n')
fi

if [ -z "$name" ] || [ "$name" = "." ] || [ "$name" = ".." ]; then
    file="$outdir/rec-$(date +%Y%m%d-%H%M%S).mkv"
else
    case "$name" in
        *.mkv)
            ;;
        *)
            name="$name.mkv"
            ;;
    esac

    file="$outdir/$name"
fi

bitrate="4M"
encode="hevc_vaapi"

wf-recorder \
    -c "$encode" \
    -r 60 \
    -b "$bitrate" \
    -f "$file" \
    --audio="$audio_device" \
    > "$logdir/wf-recorder.log" 2>&1 &

echo $! > "$pidfile"
pkill -RTMIN+8 waybar
notify-send "wf-recorder" "Started recording: $file" 
